rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && (userDoc().role == 'admin' || userDoc().role == 'analyst');
    }

    function isInvestorRelation() {
      return isSignedIn() && userDoc().role == 'investor_relation';
    }

    function isInvestor() {
      return isSignedIn() && userDoc().role == 'investor';
    }

    // Bukti Transfer proofs (image or PDF). Path: transferProofs/{investorUid}/{reportId}/{file}
    // The {reportId} segment is "standalone" for proofs not tied to a report.
    // Staff/IR may write; the targeted investor may read their own.
    match /transferProofs/{investorUid}/{reportId}/{fileName} {
      allow read: if isStaff() || isInvestorRelation() ||
        (isInvestor() && request.auth.uid == investorUid);
      allow write: if (isStaff() || isInvestorRelation()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }
  }
}

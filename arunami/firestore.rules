rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isAnalyst() {
      return isSignedIn() && userRole() == 'analyst';
    }

    function isInvestor() {
      return isSignedIn() && userRole() == 'investor';
    }

    function isInvestorRelation() {
      return isSignedIn() && userRole() == 'investor_relation';
    }

    function isStaff() {
      return isAdmin() || isAnalyst();
    }

    // Read-only access to the whole investor domain (all investors, allocations,
    // performance, communications). Investor Relations gets this in addition to
    // staff; it never grants write access.
    function canViewInvestorDomain() {
      return isStaff() || isInvestorRelation();
    }

    // Inline (resource.data) variants — used inside /portfolios/{id} where
    // `resource` IS the portfolio doc. Avoids recursive get() during list.
    function isAssignedAnalystResource() {
      return isAnalyst() && request.auth.uid in resource.data.assignedAnalysts;
    }

    function isAssignedInvestorResource() {
      return isInvestor() && request.auth.uid in resource.data.assignedInvestors;
    }

    function canReadPortfolioResource() {
      return isAdmin() || isInvestorRelation() || isAssignedAnalystResource() || isAssignedInvestorResource();
    }

    function canWritePortfolioResource() {
      return isAdmin() || isAssignedAnalystResource();
    }

    // Lookup variants — used inside subcollections where the rule needs to
    // fetch the parent portfolio to check membership.
    function lookupPortfolio(portfolioId) {
      return get(/databases/$(database)/documents/portfolios/$(portfolioId)).data;
    }

    function isAssignedAnalystOf(portfolioId) {
      return isAnalyst() && request.auth.uid in lookupPortfolio(portfolioId).assignedAnalysts;
    }

    function isAssignedInvestorOf(portfolioId) {
      return isInvestor() && request.auth.uid in lookupPortfolio(portfolioId).assignedInvestors;
    }

    function canReadPortfolio(portfolioId) {
      return isAdmin() || isInvestorRelation() || isAssignedAnalystOf(portfolioId) || isAssignedInvestorOf(portfolioId);
    }

    function canWritePortfolio(portfolioId) {
      return isAdmin() || isAssignedAnalystOf(portfolioId);
    }

    // ─── Users ───────────────────────────────────────────────────────────
    // Admin manages all users; signed-in users can read their own profile so
    // role lookup works on the client without leaking other users' data.
    match /users/{uid} {
      allow read: if canViewInvestorDomain() || (isSignedIn() && request.auth.uid == uid);
      allow list: if canViewInvestorDomain();
      allow create, delete: if isAdmin();
      // Admin edits anything; a signed-in user may edit ONLY their own
      // profile/preference fields (Phase 7) — no role/KYC/archive escalation.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['phone', 'bankName', 'bankAccountNumber', 'bankAccountHolder', 'notifyByEmail']));
    }

    // ─── Portfolios + nested collections ─────────────────────────────────
    // Both `read` and `list` use the resource-based check (no recursive get())
    // so list operations succeed when the client query filters by
    // `where('assignedAnalysts','array-contains', uid)` (or assignedInvestors).
    // An unfiltered list from a non-admin fails on the first non-matching doc.
    match /portfolios/{portfolioId} {
      allow read: if canReadPortfolioResource();
      allow list: if canReadPortfolioResource();
      allow create: if isAdmin();
      allow update: if canWritePortfolioResource();
      allow delete: if isAdmin();

      // Portfolio config: investors read, staff write
      match /config/{configId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Aggregated financial data snapshot
      match /financialData/{docId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // P&L + Projection reports + Management report HTML snapshots
      match /reports/{reportId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Analyst-authored management reports (issues, action items)
      match /managementReports/{reportId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Arunami Notes (free-text, fed to AI)
      match /notes/{noteId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Milestones & Covenants — BA-PM CRUD, investors read-only
      match /milestones/{milestoneId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }
      match /covenants/{covenantId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Per-investor draft + published reports (nested mirror)
      match /investorReports/{reportId} {
        allow read: if isStaff() ||
          (isInvestor() && resource.data.investorUid == request.auth.uid && resource.data.status == 'published');
        allow write: if canWritePortfolio(portfolioId);
      }

      // Transfer proofs (analyst confirms payouts to investors)
      match /transferProofs/{proofId} {
        allow read: if canReadPortfolio(portfolioId);
        allow write: if canWritePortfolio(portfolioId);
      }

      // Profit sharing change history (append-only audit trail).
      // Staff read/create; no updates or deletes so the trail stays immutable.
      match /equityHistory/{entryId} {
        allow read: if canReadPortfolio(portfolioId);
        allow create: if canWritePortfolio(portfolioId);
        allow update, delete: if false;
      }
    }

    // ─── Top-level investor reports mirror ───────────────────────────────
    // The investor side queries this collection by (investorUid, status) to
    // avoid having to know which portfolios they belong to up front.
    match /investorReports/{reportId} {
      allow read: if isAdmin() || isInvestorRelation() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid && resource.data.status == 'published');
      allow list: if isAdmin() || isInvestorRelation() ||
        (isInvestor() && request.query.limit <= 200);
      // Staff publish per-project reports; Investor Relations publishes the
      // accumulated (all-projects) report.
      allow create, update: if isStaff() || isInvestorRelation();
      // An investor may flip ONLY their own read-state (isRead/readAt) on their
      // own report — no other field may change through this path.
      allow update: if isInvestor()
        && resource.data.investorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isAdmin();
    }

    // ─── Investor allocations ────────────────────────────────────────────
    // Admin manages; staff read all; investors read only their own.
    match /investorAllocations/{allocationId} {
      allow read: if canViewInvestorDomain() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid);
      allow list: if canViewInvestorDomain() ||
        (isInvestor() && request.query.limit <= 200);
      allow create, update, delete: if isAdmin();
    }

    // ─── Investor communications log ─────────────────────────────────────
    match /investorCommunications/{commId} {
      allow read: if canViewInvestorDomain() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid);
      allow list: if canViewInvestorDomain() ||
        (isInvestor() && request.query.limit <= 200);
      // Investor Relations logs a communication entry when publishing reports.
      allow create, update: if isStaff() || isInvestorRelation();
      allow delete: if isAdmin();
    }

    // ─── Bukti Transfer (IR sends payout screenshots to investors) ───────
    // Top-level so IR + admin can list everything; investors only see their
    // own via a constrained `where('investorUid','==', request.auth.uid)`.
    match /investorTransferProofs/{proofId} {
      allow read: if canViewInvestorDomain() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid);
      allow list: if canViewInvestorDomain() ||
        (isInvestor() && request.query.limit <= 200);
      allow create, update: if isStaff() || isInvestorRelation();
      // IR owns the bukti-transfer flow, so IR + staff may delete (DF-05).
      allow delete: if isStaff() || isInvestorRelation();
    }

    // ─── Investor Notifications (in-app alerts) ──────────────────────────
    // Investor clears via `cleared` flip on their own doc.
    match /investorNotifications/{notifId} {
      allow read: if canViewInvestorDomain() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid);
      allow list: if canViewInvestorDomain() ||
        (isInvestor() && request.query.limit <= 200);
      allow create: if isStaff() || isInvestorRelation();
      // Only the investor who owns the notification may flip `cleared`.
      // Staff/IR update other fields (e.g. message correction) on their own.
      allow update: if (isInvestor() && resource.data.investorUid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['cleared', 'clearedAt']))
                    || isStaff() || isInvestorRelation();
      // Deleting a proof also deletes its mirrored notification (DF-05).
      allow delete: if isStaff() || isInvestorRelation();
    }

    // ─── Bagi Hasil Manual Entries (backfilled payout history) ───────────
    // Team backfills historical bagi hasil / principal that predates the app;
    // investors read only their own (constrained by investorUid). Mirrors the
    // investorTransferProofs access model.
    match /bagiHasilManualEntries/{entryId} {
      allow read: if canViewInvestorDomain() ||
        (isInvestor() && resource.data.investorUid == request.auth.uid);
      allow list: if canViewInvestorDomain() ||
        (isInvestor() && request.query.limit <= 200);
      allow create, update, delete: if isStaff() || isInvestorRelation();
    }

    // ─── Admin Data Override audit log (immutable) ───────────────────────
    // Every manual correction an admin makes via the override pages is recorded
    // here with a before/after snapshot + reason. Admin-only and append-only:
    // entries can never be edited or deleted so the trail stays trustworthy.
    match /adminOverrides/{overrideId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── Announcements (role-targeted broadcast) ─────────────────────────
    // Admin authors; any signed-in user may read/list (audience filtering is
    // client-side and the content is non-sensitive broadcast material).
    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── Documents Library (contracts & files) ───────────────────────────
    // Admin manages; staff + IR read all. Investors read documents for the
    // portfolios they hold (Phase 7) — the client constrains the list query by
    // `where('portfolioId','in', theirPortfolioIds)`; the per-doc read rule
    // enforces membership (mirrors the investorTransferProofs access model).
    match /documents/{documentId} {
      allow read: if canViewInvestorDomain()
        || (isInvestor() && resource.data.portfolioId != null && isAssignedInvestorOf(resource.data.portfolioId));
      allow list: if canViewInvestorDomain()
        || (isInvestor() && request.query.limit <= 200);
      allow create, update, delete: if isAdmin();
    }

    // ─── Distribution Batches (payout state machine) ─────────────────────
    // Admin creates & advances batches; staff + IR read for visibility.
    match /distributionBatches/{batchId} {
      allow read, list: if canViewInvestorDomain();
      allow create, update, delete: if isAdmin();
    }

    // ─── App-wide config (health thresholds, system settings) ────────────
    // Staff read (analysts compute health client-side); only admin writes.
    match /appConfig/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
